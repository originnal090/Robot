# Copy to /etc/hcirobot/tonypi-camera.env.
TONYPI_CAMERA_HOST=0.0.0.0
TONYPI_CAMERA_PORT=8080
# -1 preserves the vendor OpenCV auto-device behavior. Prefer /dev/video0 after
# confirming the stable capture node with v4l2-ctl --list-devices.
TONYPI_CAMERA_DEVICE=-1
TONYPI_CAMERA_WIDTH=640
TONYPI_CAMERA_HEIGHT=480
TONYPI_CAMERA_FPS=30
TONYPI_CAMERA_JPEG_QUALITY=70
TONYPI_CAMERA_FOURCC=YUYV
# Leave unset to inherit flip/flip_param from /boot/camera_setting.yaml.
# TONYPI_CAMERA_FLIP=-1
TONYPI_CAMERA_READ_FAILURE_LIMIT=3
TONYPI_CAMERA_MAX_REOPEN_ATTEMPTS=5
TONYPI_CAMERA_INITIAL_BACKOFF=0.2
TONYPI_CAMERA_MAX_BACKOFF=3.0
TONYPI_CAMERA_STABLE_RESET=5.0
TONYPI_CAMERA_STARTUP_TIMEOUT=15.0
TONYPI_CAMERA_STALE_TIMEOUT=10.0
