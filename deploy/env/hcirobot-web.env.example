# Copy to /etc/hcirobot/web.env; generate and set a private token before starting.
# Example generator: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HCIROBOT_WEB_TOKEN=
PYTHONUNBUFFERED=1

# deploy/start_webui.sh defaults. Set HCIROBOT_GAMEPAD=0 when the controller is
# connected to the browser computer instead of the Orange Pi.
HCIROBOT_CONFIG=/opt/hcirobot/deploy/config/config.orangepi.toml
HCIROBOT_WEB_HOST=0.0.0.0
HCIROBOT_WEB_PORT=8090
HCIROBOT_GAMEPAD=1

# Optional HTTPS for browser-side Gamepad API on another LAN device.
# HCIROBOT_WEB_CERTFILE=/etc/hcirobot/web.crt
# HCIROBOT_WEB_KEYFILE=/etc/hcirobot/web.key
